# Telegram bot that delivers the image (in Hermes: the profile's own bot via ${TELEGRAM_BOT_TOKEN})
TELEGRAM_BOT_TOKEN=123456:your-bot-token
TELEGRAM_CHAT_ID=123456789
# Optional: forum topic of the chat
TELEGRAM_THREAD_ID=

# Optional: ComfyUI wrapper on the LLM server. Defaults to http://127.0.0.1:8002.
RENDER_BACKEND=http://llm-server:8002
# Optional: seconds to wait for a render. Defaults to 600.
RENDER_TIMEOUT=600

# Optional: DEBUG, INFO, WARNING, ERROR, CRITICAL. Defaults to INFO.
LOG_LEVEL=INFO
